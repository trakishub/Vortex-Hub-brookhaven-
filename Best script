background.Parent = sg

-- Container para as Partículas
local particleHolder = Instance.new("Frame")
particleHolder.Size = UDim2.new(1, 0, 1, 0)
particleHolder.BackgroundTransparency = 1
particleHolder.Parent = background

-- 2. Partículas Flutuantes
local particles = {}
for i = 1, 45 do
    local p = Instance.new("Frame")
    p.Size = UDim2.new(0, math.random(3, 6), 0, math.random(3, 6))
    p.Position = UDim2.new(math.random(), 0, math.random(), 0)
    p.BackgroundColor3 = Color3.fromRGB(200, 150, 255)
    p.BackgroundTransparency = math.random(3, 7) / 10
    p.BorderSizePixel = 0
    p.Parent = particleHolder
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = p
    
    table.insert(particles, {
        frame = p,
        speedX = (math.random() - 0.5) * 0.0015,
        speedY = (math.random() - 0.5) * 0.0015
    })
end

-- Animação das Partículas
task.spawn(function()
    while task.wait(0.03) do
        for _, pData in ipairs(particles) do
            local p = pData.frame
            local newX = p.Position.X.Scale + pData.speedX
            local newY = p.Position.Y.Scale + pData.speedY
            
            if newX < 0 then newX = 1 elseif newX > 1 then newX = 0 end
            if newY < 0 then newY = 1 elseif newY > 1 then newY = 0 end
            
            p.Position = UDim2.new(newX, 0, newY, 0)
        end
    end
end)

